# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- Virtual environments ----
venv/
.venv/
env/

# ---- Data (streamed / generated, never committed) ----
data/

# ---- Model weights & artifacts ----
*.pt
*.pth
*.ckpt
*.pkl
*.joblib
*.parquet

# ---- Pretrained embeddings (downloaded, large) ----
glove*
*.zip
*.gz

# ---- Hugging Face / Streamlit caches ----
.cache/
.streamlit/secrets.toml

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Secrets ----
.env

# NOTE: results/ IS tracked on purpose - metrics and plots are part of the portfolio.

# ---- Trained model checkpoints ----
models/

# ---- Cached model probabilities (regenerable via src.optimize) ----
results/probabilities/

# ---- Node (only used to generate the report .docx) ----
node_modules/

# ---- Office temp/lock files and local report drafts ----
~$*
~WRL*.tmp
/Front Page.docx
/Report.docx
